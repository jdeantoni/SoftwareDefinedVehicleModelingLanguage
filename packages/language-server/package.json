{
    "name": "sdvml-language-server",
    "displayName": "sdvml-langium",
    "description": "Language server for the Sdvml example",
    "version": "0.6.0",
    "private": true,
    "homepage": "TODO",
    "bugs": "https://github.com/TODO",
    "engines": {
        "vscode": "^1.46.0"
    },
    "author": {
        "name": "Eclipse Sprotty"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TODO",
        "directory": "packages/language-server"
    },
    "type": "module",
    "dependencies": {
        "langium": "^3.5.0",
        "langium-sprotty": "^3.5.0",
        "sprotty-elk": "^1.4.0",
        "vscode-languageserver": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^24.0.12",
        "langium-cli": "^3.5.2"
    },
    "scripts": {
        "prepare": "yarn run clean && yarn run langium:generate && yarn run build",
        "clean": "shx rm -fr out",
        "build": "tsc --noEmit",
        "watch": "tsc --noEmit --watch",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch"
    }
