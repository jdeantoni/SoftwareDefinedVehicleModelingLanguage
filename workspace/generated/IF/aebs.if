system aebs;
type int = range 0 .. 255;
signal Camera();
signal Lidar();
signal Radar();
signal Fusion_data();
signal Brake();
signal Alarm();
process Camera(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Camera_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Camera_FINISH";
            reset e;
			output Camera() to {Fusion_S3}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Lidar(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Lidar_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Lidar_FINISH";
            reset e;
			output Lidar() to {Fusion_S3}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Radar(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Radar_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Radar_FINISH";
            reset e;
			output Radar() to {Fusion_S3}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Brake(1);
    var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
        input Brake();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0;
            set e := 0;
            nextstate preprocessing;
        input Brake();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "Brake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "Brake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Brake_FINISH";
            reset e;
            nextstate wait;
        input Brake();
			task nbData := nbData + 1;
			nextstate processing;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
        input Brake();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process Alarm(1);
    var e clock;
    state wait #start ;
        input Alarm();
            informal "Alarm_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Alarm_FINISH";
            reset e;
            nextstate wait;
    endstate;
endprocess;
process Fusion_S3(1);
	var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
		input Camera();
			task nbData := nbData + 1;
			nextstate first;
		input Lidar();
			task nbData := nbData + 1;
			nextstate first;
		input Radar();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0;
            set e := 0;
            nextstate preprocessing;
		input Camera();
			task nbData := nbData + 1;
			nextstate jitter;
		input Lidar();
			task nbData := nbData + 1;
			nextstate jitter;
		input Radar();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "Fusion_S3_USELESS_EXEC";
            nextstate processing1;
        deadline eager;
        provided nbData <>  0;
            informal "Fusion_S3_USEFUL_EXEC";
            task nbData := 0;
            nextstate processing2;
    endstate;
    state processing1;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Fusion_S3_FINISH";
            reset e;
            nextstate wait;
		input Camera();
			task nbData := nbData + 1;
			nextstate processing1;
		input Lidar();
			task nbData := nbData + 1;
			nextstate processing1;
		input Radar();
			task nbData := nbData + 1;
			nextstate processing1;
    endstate;
    state processing2;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Fusion_S3_FINISH";
			output Fusion_data() to {AEB_controler_S2}0;
            reset e;
            nextstate wait;
		input Camera();
			task nbData := nbData + 1;
			nextstate processing2;
		input Lidar();
			task nbData := nbData + 1;
			nextstate processing2;
		input Radar();
			task nbData := nbData + 1;
			nextstate processing2;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
		input Camera();
			task nbData := nbData + 1;
			nextstate wait;
		input Lidar();
			task nbData := nbData + 1;
			nextstate wait;
		input Radar();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process AEB_controler_S2(1);
	var e clock;
    state wait #start ;
        input Fusion_data();
            informal "AEB_controler_S2_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "AEB_controler_S2_FINISH";
			output Alarm() to {Alarm}0;
			output Brake() to {Brake}0;
            reset e;
            nextstate wait;
    endstate;
endprocess;
endsystem;
