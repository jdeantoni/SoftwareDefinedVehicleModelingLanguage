system test1;
type int = range 0 .. 255;
Signal Camera();
Signal Lidar();
Signal FrontBrake();
Signal RearBrake();
process Camera(1);
    var x clock;
    var e clock;

    state startS #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 10; //mean - stdDev ?
            informal "Camera_START";
            set x := 0;
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 6 and e <= 14;
            informal "Camera_FINISH";
            reset e;
            output Camera();
            nextstate wait;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4 ;
            informal "Camera_START";
            set e := 0;
            nextstate exec;
    endstate;
endprocess;
process Lidar(1);
    var x clock;
    var e clock;

    state startS #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 10; //mean - stdDev ?
            informal "Lidar_START";
            set x := 0;
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 6 and e <= 14;
            informal "Lidar_FINISH";
            reset e;
            output Lidar();
            nextstate wait;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4 ;
            informal "Lidar_START";
            set e := 0;
            nextstate exec;
    endstate;
endprocess;
process FrontBrake(1);
    var x clock;
    var e clock;
    var nbData int;
    state startA #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        when x >= 0 and x <= 10; //mean - stdDev ?
            set x := 0;
            set e := 0;
            nextstate preprocessing;

        input FrontBrake;
            task nbData := nbData + 1;
            nextstate first;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;

        input FrontBrake;
            task nbData := nbData + 1;
            nextstate wait;
    endstate;
    state jitter;
        deadline delayable;
        when x <= (3 * 2));
            set e := 0;
            nextstate preprocessing;

        input FrontBrake;
            task nbData := nbData + 1;
            nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "FrontBrake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "FrontBrake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when x >= 1 and x <= 9;
            informal "FrontBrake_FINISH";
            reset e;
            nextstate wait;

        input FrontBrake();
            task nbData := nbData + 1;
            nextstate processing;
    endstate;
endprocess;
process RearBrake(1);
    var x clock;
    var e clock;
    var nbData int;
    state startA #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        when x >= 0 and x <= 10; //mean - stdDev ?
            set x := 0;
            set e := 0;
            nextstate preprocessing;

        input RearBrake;
            task nbData := nbData + 1;
            nextstate first;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;

        input RearBrake;
            task nbData := nbData + 1;
            nextstate wait;
    endstate;
    state jitter;
        deadline delayable;
        when x <= (3 * 2));
            set e := 0;
            nextstate preprocessing;

        input RearBrake;
            task nbData := nbData + 1;
            nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "RearBrake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "RearBrake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when x >= 1 and x <= 9;
            informal "RearBrake_FINISH";
            reset e;
            nextstate wait;

        input RearBrake();
            task nbData := nbData + 1;
            nextstate processing;
    endstate;
endprocess;
process AEBS_controler_s1(1);
	var x clock;

    state wait #start ;
        input undefined();
            informal "AEBS_controler_s1_START";
            set x := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when x >= 1 and x <= 5;
            informal "AEBS_controler_s1_FINISH";
            output FB() to {TODO}0;
            reset x;
            nextstate wait;
    endstate;
endprocess;
process SecondControler_s2(1);
	var x clock;

    state wait #start ;
        input Al();
            informal "SecondControler_s2_START";
            set x := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when x >= 1 and x <= 5;
            informal "SecondControler_s2_FINISH";
            output undefined() to {TODO}0;
            reset x;
            nextstate wait;
    endstate;
endprocess;
