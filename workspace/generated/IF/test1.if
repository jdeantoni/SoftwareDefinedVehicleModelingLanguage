system test1;
type int = range 0 .. 255;
signal Camera();
signal Lidar();
signal Alarm();
signal FrontBrake();
signal RearBrake();
process Camera(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 6;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 8 ;
            informal "Camera_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 9;
            informal "Camera_FINISH";
            reset e;
			output Camera() to {AEBS_controler_s1}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Lidar(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 6;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 8 ;
            informal "Lidar_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 9;
            informal "Lidar_FINISH";
            reset e;
			output Lidar() to {AEBS_controler_s1}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process FrontBrake(1);
    var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 6;
            set x := 0;
            nextstate jitter;
        input FrontBrake();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 8;
            set e := 0;
            nextstate preprocessing;
        input FrontBrake();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "FrontBrake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "FrontBrake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 9;
            informal "FrontBrake_FINISH";
            reset e;
            nextstate wait;
        input FrontBrake();
			task nbData := nbData + 1;
			nextstate processing;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
        input FrontBrake();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process RearBrake(1);
    var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 6;
            set x := 0;
            nextstate jitter;
        input RearBrake();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 8;
            set e := 0;
            nextstate preprocessing;
        input RearBrake();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "RearBrake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "RearBrake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 9;
            informal "RearBrake_FINISH";
            reset e;
            nextstate wait;
        input RearBrake();
			task nbData := nbData + 1;
			nextstate processing;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
        input RearBrake();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process AEBS_controler_s1(1);
	var e clock;
    state wait #start ;
        input Lidar();
            informal "AEBS_controler_s1_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 5;
            informal "AEBS_controler_s1_FINISH";
			output FrontBrake() to {FrontBrake}0;
			output Alarm() to {SecondControler_s2}0;
            reset e;
            nextstate wait;
    endstate;
endprocess;
process SecondControler_s2(1);
	var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 8;
            set x := 0;
            nextstate jitter;
		input Alarm();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4;
            set e := 0;
            nextstate preprocessing;
		input Alarm();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "SecondControler_s2_USELESS_EXEC";
            nextstate processing1;
        deadline eager;
        provided nbData <>  0;
            informal "SecondControler_s2_USEFUL_EXEC";
            task nbData := 0;
            nextstate processing2;
    endstate;
    state processing1;
        deadline delayable;
        when e >= 1 and e <= 5;
            informal "SecondControler_s2_FINISH";
            reset e;
            nextstate wait;
		input Alarm();
			task nbData := nbData + 1;
			nextstate processing1;
    endstate;
    state processing2;
        deadline delayable;
        when e >= 1 and e <= 5;
            informal "SecondControler_s2_FINISH";
			output RearBrake() to {RearBrake}0;
            reset e;
            nextstate wait;
		input Alarm();
			task nbData := nbData + 1;
			nextstate processing2;
    endstate;
    state wait;
        when x = 10;
            set x := 0;
            nextstate jitter;
		input Alarm();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
endsystem;
