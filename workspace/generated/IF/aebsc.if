system aebsc;
type int = range 0 .. 255;
signal Camera();
signal Lidar();
signal Radar();
signal Brake();
signal Alarm();
signal Detection_data();
signal Reaction_data();
signal Processed_detection();
process Camera(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Camera_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Camera_FINISH";
            reset e;
			output Camera() to {Data_hub_Fuse_camera}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Lidar(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Lidar_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Lidar_FINISH";
            reset e;
			output Lidar() to {Data_hub_Fuse_detection}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Radar(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0 ;
            informal "Radar_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Radar_FINISH";
            reset e;
			output Radar() to {Data_hub_Fuse_detection}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Brake(1);
    var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first ;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
        input Brake();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0;
            set e := 0;
            nextstate preprocessing;
        input Brake();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "Brake_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData <>  0;
            informal "Brake_USEFUL_ACT";
            task nbData := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Brake_FINISH";
            reset e;
            nextstate wait;
        input Brake();
			task nbData := nbData + 1;
			nextstate processing;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
        input Brake();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process Alarm(1);
    var e clock;
    state wait #start ;
        input Alarm();
            informal "Alarm_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Alarm_FINISH";
            reset e;
            nextstate wait;
    endstate;
endprocess;
process Data_hub_Fuse_detection(1);
	var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
		input Lidar();
			task nbData := nbData + 1;
			nextstate first;
		input Radar();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0;
            set e := 0;
            nextstate preprocessing;
		input Lidar();
			task nbData := nbData + 1;
			nextstate jitter;
		input Radar();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "Data_hub_USELESS_EXEC";
            nextstate processing1;
        deadline eager;
        provided nbData <>  0;
            informal "Data_hub_USEFUL_EXEC";
            task nbData := 0;
            nextstate processing2;
    endstate;
    state processing1;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Data_hub_FINISH";
            reset e;
            nextstate wait;
		input Lidar();
			task nbData := nbData + 1;
			nextstate processing1;
		input Radar();
			task nbData := nbData + 1;
			nextstate processing1;
    endstate;
    state processing2;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Data_hub_FINISH";
			output Detection_data() to {AEB_controler_Compute_detection}0;
            reset e;
            nextstate wait;
		input Lidar();
			task nbData := nbData + 1;
			nextstate processing2;
		input Radar();
			task nbData := nbData + 1;
			nextstate processing2;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
		input Lidar();
			task nbData := nbData + 1;
			nextstate wait;
		input Radar();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process Data_hub_Fuse_camera(1);
	var x clock;
    var e clock;
    var nbData int;
    state start #start ;
        task nbData := 0;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 5;
            set x := 0;
            nextstate jitter;
		input Camera();
			task nbData := nbData + 1;
			nextstate first;
		input Processed_detection();
			task nbData := nbData + 1;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 0;
            set e := 0;
            nextstate preprocessing;
		input Camera();
			task nbData := nbData + 1;
			nextstate jitter;
		input Processed_detection();
			task nbData := nbData + 1;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData =  0;
            informal "Data_hub_USELESS_EXEC";
            nextstate processing1;
        deadline eager;
        provided nbData <>  0;
            informal "Data_hub_USEFUL_EXEC";
            task nbData := 0;
            nextstate processing2;
    endstate;
    state processing1;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Data_hub_FINISH";
            reset e;
            nextstate wait;
		input Camera();
			task nbData := nbData + 1;
			nextstate processing1;
		input Processed_detection();
			task nbData := nbData + 1;
			nextstate processing1;
    endstate;
    state processing2;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Data_hub_FINISH";
			output Alarm() to {Alarm}0;
			output Reaction_data() to {AEB_controler_Compute_reaction}0;
            reset e;
            nextstate wait;
		input Camera();
			task nbData := nbData + 1;
			nextstate processing2;
		input Processed_detection();
			task nbData := nbData + 1;
			nextstate processing2;
    endstate;
    state wait;
        when x = 5;
            set x := 0;
            nextstate jitter;
		input Camera();
			task nbData := nbData + 1;
			nextstate wait;
		input Processed_detection();
			task nbData := nbData + 1;
			nextstate wait;
    endstate;
endprocess;
process AEB_controler_Compute_detection(1);
	var e clock;
    state wait #start ;
        input Detection_data();
            informal "AEB_controler_Compute_detection_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "AEB_controler_Compute_detection_FINISH";
			output Processed_detection() to {Data_hub_Fuse_camera}0;
            reset e;
            nextstate wait;
    endstate;
endprocess;
process AEB_controler_Compute_reaction(1);
	var e clock;
    state wait #start ;
        input Reaction_data();
            informal "AEB_controler_Compute_reaction_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "AEB_controler_Compute_reaction_FINISH";
			output Alarm() to {Alarm}0;
			output Brake() to {Brake}0;
            reset e;
            nextstate wait;
    endstate;
endprocess;
endsystem;
