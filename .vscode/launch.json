// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
    "configurations": [
        {
            "name": "Sdvml Example with Panel Manager (Langium)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "env": {
                "DIAGRAM_MODE": "panel"
            },
            "args": [
                "${workspaceFolder}/workspace",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/extension/pack/extension/src/*"
            ],
            "sourceMaps": true
        },
        {
            "name": "Sdvml Example with Editor (Langium)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "env": {
                "DIAGRAM_MODE": "editor"
            },
            "args": [
                "${workspaceFolder}/workspace",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/extension/pack/extension/src/*"
            ],
            "sourceMaps": true
        },
        {
            "name": "Sdvml Example with View (Langium)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "env": {
                "DIAGRAM_MODE": "view"
            },
            "args": [
                "${workspaceFolder}/workspace",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/extension/pack/extension/src/*"
            ],
            "sourceMaps": true
        },
        {
            "name": "Attach to Language Server",
            "type": "node",
            "port": 6009,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/extension/pack/language-server/src/*"
            ]
        },
    ]
}